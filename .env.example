# Supabase dashboard > Project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY

# Plaid: dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Configure in Plaid dashboard if linking OAuth banks:
PLAID_REDIRECT_URI=
# Public deployed HTTPS URL. Omit locally; sync via button before deploying.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base64 of 32 random bytes: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Optional push notifications: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Secret required for scheduled reminders: openssl rand -hex 32
CRON_SECRET=
